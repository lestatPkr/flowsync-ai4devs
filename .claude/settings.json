{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Formateando frontend con Prettier...",
            "timeout": 30,
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/frontend/*) cd \"$CLAUDE_PROJECT_DIR/frontend\" && ./node_modules/.bin/prettier --write --ignore-unknown \"$f\";; esac; } 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Comprobando la valla (BOUNDARIES.md)...",
            "timeout": 10,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-fence.sh"
          },
          {
            "type": "command",
            "statusMessage": "Definition of Done: suite del backend (y cobertura si es un PR)...",
            "timeout": 120,
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-tests.mjs"
          },
          {
            "type": "command",
            "statusMessage": "Comprobando la valla del diseño (DESIGN.md + tokens)...",
            "timeout": 10,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-design.sh"
          },
          {
            "type": "command",
            "statusMessage": "Definition of Done del frontend: build + lint (y e2e si es un PR)...",
            "timeout": 300,
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-frontend.mjs"
          },
          {
            "type": "command",
            "statusMessage": "Jev: ¿es seguro este comando para lo que se ha pedido?",
            "timeout": 15,
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-jev.mjs"
          }
        ]
      }
    ]
  }
}
